          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевести «%@» в режим ожидания по DDC?"
          }
        }
      }
    },
    "Puts every item back where it was by default and closes open sections. Display names, icons, hidden displays, the order and the options below stay as they are." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает каждый пункт на место по умолчанию и закрывает открытые разделы. Названия экранов, значки, скрытые экраны, порядок и параметры ниже остаются как есть."
          }
