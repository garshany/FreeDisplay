            "value" : "Путь к профилю"
          }
        }
      }
    },
    "Profiles in %@. FreeDisplay imports copies here and removes only copies from here; profiles of macOS, other users or apps stay in the profile chooser but are left alone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили в %@. FreeDisplay импортирует копии сюда и удаляет только копии отсюда; профили macOS, других пользователей и программ остаются в списке выбора, но не трогаются."
          }
        }
      }
    },
    "Projector" : {
