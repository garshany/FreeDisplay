    "EDID and HiDPI…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDID и HiDPI…"
          }
        }
      }
    },
    "EDID file" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл EDID"
          }
