    "Lifecycle (disconnect / reconnect)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключение и восстановление"
          }
        }
      }
    },
    "Light can’t be negative, so 0 nits was stored." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яркость не может быть отрицательной, поэтому сохранено 0 нит."
