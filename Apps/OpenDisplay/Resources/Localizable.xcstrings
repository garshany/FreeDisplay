          "stringUnit" : {
            "state" : "translated",
            "value" : "В избранное"
          }
        }
      }
    },
    "Adding a display uses its currently known brightness as the editable Restore value. It adds no schedule points and does not change brightness." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При добавлении дисплея его известная текущая яркость предлагается как редактируемое значение восстановления. Точки расписания не добавляются, яркость не меняется."
          }
        }
      }
    },
    "Adjust the current output when no display can" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
