            "value" : "Отправка…"
          }
        }
      }
    },
    "Sends an explicit action to the TV controller paired to this display; a sent request does not confirm a physical effect." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет явную команду контроллеру телевизора, сопряжённому с этим дисплеем; отправка запроса не подтверждает физическое действие."
          }
        }
      }
    },
