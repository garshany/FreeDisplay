          }
        }
      }
    },
    "Turn the built-in display off when an external connects" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать встроенный экран при подключении внешнего"
          }
        }
      }
    },
    "Turn this on if DDC values change but the picture doesn’t. Software brightness uses the dimming method selected below." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите, если значения DDC меняются, а изображение — нет. Программная яркость использует выбранный ниже способ затемнения."
          }
        }
      }
    },
    "Turned off automatically because an external display connected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключен автоматически после подключения внешнего дисплея."
          }
        }
      }
    },
    "Turned off by FreeDisplay" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключен FreeDisplay"
          }
        }
      }
    },
    "Turning schedules off keeps current brightness. Restore stays available and turns scheduling off before applying that display’s declared value. Already dispatched writes may finish; other apps and hardware buttons can still change brightness." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключение расписаний сохраняет текущую яркость. Восстановление остаётся доступно и выключает расписание перед применением заданного значения дисплея. Уже отправленные команды могут завершиться; другие приложения и кнопки монитора по-прежнему могут менять яркость."
          }
        }
      }
    },
    "Turning the built-in display off when an external connects" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключение встроенного экрана при подключении внешнего"
          }
        }
      }
    },
    "Turning this off would leave no physical display on" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если отключить этот экран, не останется ни одного физического экрана"
          }
        }
      }
    },
    "Turns one display off; refused when it would leave no usable screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключает один дисплей; операция отклоняется, если не останется рабочего экрана."
          }
        }
      }
    },
    "TV authorization denied" : {
