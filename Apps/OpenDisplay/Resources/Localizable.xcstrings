    "public APIs only" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "только публичные API"
          }
        }
      }
    },
    "Publishes each brightness and volume change OpenDisplay makes — including slider, HTTP, command-line and Shortcuts brightness changes — over the dev.opendisplay.osd distributed notification, whether or not OpenDisplay shows its own HUD. Off by default." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаёт каждое изменение яркости и громкости, сделанное OpenDisplay, — включая изменения яркости ползунком, по HTTP, из командной строки и из «Быстрых команд» — через распределённое уведомление dev.opendisplay.osd, независимо от того, показывает ли OpenDisplay свой индикатор. По умолчанию выключено."
          }
        }
      }
    },
    "Put in Standby" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевести в режим ожидания"
          }
        }
      }
    },
    "Put my arrangement back when it changes" : {
