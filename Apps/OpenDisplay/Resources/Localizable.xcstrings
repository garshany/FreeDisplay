            "value" : "Подключать нечего"
          }
        }
      }
    },
    "Nothing was changed: OpenDisplay still has “%@” switched off. Reconnect it first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменено: «%@» всё ещё выключен OpenDisplay. Сначала подключите его."
          }
        }
      }
    },
    "Nothing was changed: “%@” is no longer remembered." : {
      "localizations" : {
