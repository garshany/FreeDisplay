    },
    "Transfer functions: %1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаточные функции: %1"
          }
        }
      }
    },
    "Transfer replaces the selected destination settings and forgets the source record after confirmation. Physical identities stay separate. Migration moves selected preferences between identifiers of one recognized record. Cancel changes nothing." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После подтверждения перенос заменяет выбранные настройки назначения и удаляет исходную запись. Физические идентичности остаются раздельными. Миграция перемещает выбранные настройки между идентификаторами одной распознанной записи. Отмена ничего не меняет."
          }
        }
      }
    },
    "Transfer settings from offline record…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
