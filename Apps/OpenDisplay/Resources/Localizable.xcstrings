      }
    },
    "On some monitors, a capabilities request hangs DDC until the power is cycled." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос возможностей у некоторых мониторов подвешивает DDC до выключения питания."
          }
        }
      }
    },
    "On-screen display" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экранный индикатор"
          }
        }
      }
    },
    "on/off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "вкл./выкл."
          }
        }
      }
    },
    "on/off state" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "включение/выключение"
          }
        }
      }
    },
    "One display’s More at a time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ещё» только у одного экрана"
          }
        }
      }
    },
    "One feature at a time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только одна функция за раз"
          }
        }
      }
    },
    "One standard step is %@ %% of the range; one fine step is %@ %%. Hold ⇧⌥ with a brightness or volume key for the other step. The fine-step shortcuts always take fine steps. A monitor with fewer levels of its own may round a step." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный шаг — %@ %% диапазона, малый — %@ %%. Чтобы взять другой шаг, удерживайте ⇧⌥ вместе с клавишей яркости или громкости. Сочетания для малого шага всегда меняют уровень малым шагом. Монитор с меньшим числом собственных уровней может округлить шаг."
          }
        }
      }
    },
    "Only profiles in your own profiles folder can be removed here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь можно удалить только профили из вашей собственной папки профилей."
          }
        }
      }
    },
    "Only the standard 0…1 domain is supported" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживается только стандартный диапазон 0…1"
          }
        }
      }
    },
    "Open Accessibility Settings…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки универсального доступа…"
          }
        }
      }
    },
    "Open Folder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть папку"
          }
        }
      }
    },
    "Open in ColorSync Utility" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть в ColorSync-утилите"
          }
        }
