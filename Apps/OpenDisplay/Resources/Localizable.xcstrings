          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиатура и звук"
          }
        }
      }
    },
    "Keyboard shortcuts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетания клавиш"
          }
