          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратная косая черта в конце строки."
          }
        }
      }
    },
    "Transfer Characteristics" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаточные характеристики"
          }
        }
