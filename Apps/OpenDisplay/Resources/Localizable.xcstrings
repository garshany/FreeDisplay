    "EDID hash" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хеш EDID"
          }
        }
      }
    },
    "EDID of this display" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDID этого дисплея"
          }
        }
      }
    },
    "EDID rejected: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDID отклонён: %@"
          }
        }
      }
    },
    "EDID size must be 128 to 32768 bytes and a multiple of 128." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер EDID должен составлять от 128 до 32768 байт и быть кратным 128."
          }
        }
      }
    },
    "EDID version" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия EDID"
          }
        }
      }
    },
    "EDR headroom" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запас EDR"
          }
        }
      }
    },
    "EDR headroom describes macOS’s current output. It doesn’t confirm that HDR reaches the display, and it doesn’t turn on hardware HDR." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запас EDR описывает текущий вывод macOS. Он не подтверждает передачу HDR на монитор и не включает аппаратный HDR."
          }
        }
      }
    },
    "Empty: follow the associated sound output. An override changes key engagement without changing the volume destination." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пустое поле: следовать связанному аудиовыходу. Переопределение изменяет правило захвата клавиш, сохраняя выход для регулировки громкости."
          }
        }
      }
    },
    "Enable HTTP control" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить управление через HTTP"
          }
        }
      }
    },
    "Enable TV control" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить управление телевизором"
          }
        }
      }
    },
    "Enabled" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено"
          }
        }
      }
    },
    "Enter a brightness percentage and a positive duration in seconds. The original brightness is read first and sent back afterwards. A successful request does not prove a visible response." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите яркость в процентах и положительную длительность в секундах. Сначала считывается исходная яркость, а после проверки отправляется команда её восстановления. Успешный запрос не доказывает видимого изменения."
          }
        }
      }
    },
    "Enter a display name of 1–128 bytes with no null characters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите название экрана длиной 1–128 байт без нулевых символов."
          }
        }
      }
    },
    "Enter a finite number of seconds, or leave blank for automatic." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите конечное число секунд или оставьте поле пустым для автоматического значения."
          }
        }
      }
    },
    "Enter a nonnegative integer, or leave blank for no limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите неотрицательное целое число или оставьте поле пустым для отключения ограничения."
          }
        }
      }
    },
    "Enter a positive discovery window and whole-second SSDP response delay." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите положительное время поиска и задержку ответа SSDP в целых секундах."
          }
        }
      }
    },
    "Enter a valid host, service port and positive deadlines. Approve a certificate fingerprint only after verifying this TV." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите корректный узел, порт службы и положительное время ожидания. Подтверждайте отпечаток сертификата только после проверки этого телевизора."
          }
        }
      }
    },
    "Enter deadlines explicitly. FreeDisplay does not retry commands automatically." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите время ожидания явно. FreeDisplay не повторяет команды автоматически."
          }
        }
      }
    },
    "Enter valid latitude and longitude in decimal degrees." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите допустимые широту и долготу в десятичных градусах."
          }
        }
      }
    },
    "Enter valid positive pixel dimensions." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите допустимые положительные размеры в пикселях."
          }
        }
      }
    },
    "entered by you" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "введено вами"
          }
        }
      }
    },
    "entered by you as an estimate" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "введено вами как оценка"
          }
        }
      }
    },
    "entered by you, from the display’s specification" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "введено вами по характеристикам дисплея"
          }
        }
      }
    },
    "entered by you, from your own measurement" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "введено вами по собственному измерению"
          }
        }
      }
    },
    "Entered values" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введённые значения"
          }
        }
      }
    },
    "Entries macOS lists for this display: %lld. Distinct modes: %lld; usable for the desktop: %lld; not meant for desktop use: %lld; HiDPI: %lld; LoDPI: %lld." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей, которые macOS перечисляет для этого дисплея: %lld. Различных режимов: %lld; пригодных для рабочего стола: %lld; не для рабочего стола: %lld; HiDPI: %lld; LoDPI: %lld."
          }
        }
      }
    },
    "Entries that repeat another mode’s logical size, framebuffer and refresh rate exactly: %lld. A mode change can’t choose between them, so each is listed once." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей, точно повторяющих логический размер, буфер изображения и частоту другого режима: %lld. Смена режима не может выбрать между ними, поэтому каждый показан один раз."
          }
        }
      }
    },
    "Entries that repeat another mode’s size, framebuffer and rate exactly, shown once: %1." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей, точно повторяющих размер, буфер и частоту другого режима (показаны один раз): %1."
          }
        }
      }
    },
    "env must wrap a supported interpreter with a literal script file" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "env должен запускать поддерживаемый интерпретатор с файлом скрипта, путь к которому задан без подстановок"
          }
        }
      }
    },
    "env requires an absolute literal executable and a validated argument array" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для env требуется абсолютный путь к исполняемому файлу без подстановок и проверенный массив аргументов"
          }
        }
      }
    },
    "Established timings" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандартные тайминги (Established)"
          }
        }
      }
    },
    "Evening preset" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечерний режим"
          }
        }
      }
    },
    "Evening starts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало вечера"
          }
        }
