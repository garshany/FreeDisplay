    },
    "%@ switched modes. Keep the new mode in OpenDisplay within %lld seconds, or it reverts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим дисплея %@ изменён. Подтвердите его в OpenDisplay в течение %lld с, иначе он вернётся."
          }
        }
      }
    },
    "%@ wasn’t reconnected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
