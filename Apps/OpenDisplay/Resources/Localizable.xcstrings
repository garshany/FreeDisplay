    },
    "Tools" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты"
          }
        }
      }
    },
    "Top" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вверху"
          }
        }
      }
    },
    "Turn built-in off when an external connects" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать встроенный экран при подключении монитора"
          }
        }
      }
    },
    "Turn display off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить монитор"
          }
        }
      }
    },
    "Turn off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключить"
          }
        }
      }
    },
    "Turn Off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить"
          }
        }
      }
    },
    "Turn off after" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать через"
          }
        }
      }
    },
    "Turn off below" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать при заряде ниже"
          }
        }
      }
    },
    "Turn off in Low Power Mode" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать в режиме энергосбережения"
          }
        }
      }
    },
    "Turn off on battery power" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать при питании от аккумулятора"
          }
        }
      }
    },
    "Turn off the display (turn it back on with the same switch)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить экран (вернуть — этим же переключателем)"
          }
        }
      }
    },
    "Turn the built-in display off when an external connects" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключать встроенный экран при подключении внешнего"
          }
        }
      }
    },
    "Turn this on if DDC values change but the picture doesn’t. Software brightness uses the dimming method selected below." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите, если значения DDC меняются, а изображение — нет. Программная яркость использует выбранный ниже способ затемнения."
          }
        }
      }
    },
    "Turned off automatically because an external display connected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключен автоматически после подключения внешнего дисплея."
          }
        }
      }
    },
    "Turned off by OpenDisplay" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключён OpenDisplay"
          }
        }
      }
    },
    "Type" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тип"
          }
        }
      }
    },
    "Unavailable" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно"
          }
        }
      }
    },
    "Unavailable in Safe Mode." : {
      "localizations" : {
        "ru" : {
