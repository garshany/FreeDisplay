      }
    },
    "Prevents idle display sleep only. It does not prevent system sleep, lid sleep or Sleep chosen by the user. Other apps can hold their own assertions independently." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрещает только сон дисплеев при бездействии. Не запрещает сон системы, сон при закрытии крышки или выбранный пользователем сон. Другие приложения могут независимо удерживать собственные запреты."
          }
        }
      }
    },
    "Preview closed; stopping the system capture reported: %@" : {
      "localizations" : {
