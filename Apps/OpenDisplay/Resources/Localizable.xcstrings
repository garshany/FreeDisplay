    },
    "Recognition threshold" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог распознавания"
          }
        }
      }
    },
    "Recognition uses qualified vendor/model/serial first, then the same-Mac UUID, then a unique fingerprint score. A tie requires an explicit choice. A changed UUID can leave preferences under an earlier identifier; migration is always previewed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала распознавание проверяет производителя, модель и серийный номер, затем UUID на этом Mac, затем единственное лучшее совпадение отпечатка. При равных оценках нужен явный выбор. После смены UUID настройки могут остаться под прежним идентификатором; перед миграцией всегда показывается предпросмотр."
          }
        }
      }
    },
    "Recognized by a unique fingerprint score" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознано по единственному лучшему совпадению отпечатка"
          }
        }
      }
    },
