            "value" : "Экранный индикатор"
          }
        }
      }
    },
    "on/off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "вкл./выкл."
          }
        }
      }
    },
    "on/off state" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "включение/выключение"
          }
        }
      }
    },
    "One display’s More at a time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ещё» только у одного экрана"
          }
        }
      }
    },
    "One feature at a time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только одна функция за раз"
          }
        }
      }
    },
    "One sound when the key is released or a volume slider is let go, on the output that changed when that is known. Hold ⇧ (without ⌥) for the opposite. %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один звук при отпускании клавиши или ползунка громкости, через изменённый выход, если он известен. Удерживайте ⇧ без ⌥ для противоположного поведения. %@"
          }
        }
      }
    },
    "One standard step is %@ %% of the range; one fine step is %@ %%. Hold ⇧⌥ with a brightness or volume key for the other step. The fine-step shortcuts always take fine steps. A monitor with fewer levels of its own may round a step." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный шаг — %@ %% диапазона, малый — %@ %%. Чтобы взять другой шаг, удерживайте ⇧⌥ вместе с клавишей яркости или громкости. Сочетания для малого шага всегда меняют уровень малым шагом. Монитор с меньшим числом собственных уровней может округлить шаг."
          }
        }
      }
    },
    "Only active displays with verified physical presence can own the assertion. Turning off one display’s preference leaves other owners and the global external-display preference unchanged." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживать запрет сна могут только активные дисплеи с подтверждённым физическим присутствием. Отключение настройки одного дисплея не затрагивает остальных владельцев запрета и общую настройку для внешних дисплеев."
          }
        }
      }
    },
    "Only for displays macOS can’t adjust itself" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для дисплеев, которыми macOS не может управлять самостоятельно"
          }
        }
      }
    },
    "Only in the current fingerprint" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть только в текущих данных"
          }
        }
      }
    },
    "Only in the remembered record" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть только в сохранённой записи"
          }
        }
      }
    },
    "Only profiles in your own profiles folder can be removed here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь можно удалить только профили из вашей собственной папки профилей."
          }
        }
      }
    },
    "Only the standard 0…1 domain is supported" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживается только стандартный диапазон 0…1"
          }
        }
      }
    },
    "Open Accessibility Settings…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки универсального доступа…"
          }
        }
      }
    },
    "Open Folder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
