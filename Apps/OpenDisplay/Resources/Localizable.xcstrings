          }
        }
      }
    },
    "Save wake settings before sending. WOL is independent of pairing and requires the correct Ethernet or Wi-Fi MAC, network standby and a reachable route. Packet submission does not confirm wake." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед отправкой сохраните настройки пробуждения. WOL не зависит от сопряжения и требует правильного MAC-адреса Ethernet или Wi-Fi, сетевого режима ожидания и доступного маршрута. Отправка пакета не подтверждает пробуждение."
          }
        }
      }
    },
    "saved %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "сохранено %@"
          }
