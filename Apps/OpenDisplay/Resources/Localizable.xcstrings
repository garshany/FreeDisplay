    },
    "Listed by macOS" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечислено macOS"
          }
        }
      }
    },
    "Listening for the keys" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перехват клавиш активен"
          }
        }
      }
    },
    "Lists every exact mode a connected display offers, current mode first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечисляет все точные режимы подключённого дисплея; текущий режим идёт первым."
          }
        }
      }
    },
    "Lists every mode macOS reports, including the ones it marks as not usable for a desktop. Such a mode can leave the picture blank or distorted; like any new mode it has to be confirmed, or it reverts on its own." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает все режимы, о которых сообщает macOS, включая помеченные как непригодные для рабочего стола. В таком режиме изображение может пропасть или исказиться; как и любой новый режим, его нужно подтвердить, иначе он вернётся сам."
          }
        }
      }
    },
    "Lists the displays automation can name, connected or remembered." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечисляет подключённые и сохранённые дисплеи, доступные автоматизации."
          }
        }
      }
    },
    "Lists the installed display ICC profiles." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечисляет установленные ICC-профили дисплеев."
          }
        }
      }
    },
    "Load .cube LUT…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузить LUT .cube…"
          }
        }
      }
    },
    "Load sources to begin. macOS may ask for Screen Recording access. The preview stays in memory; protected content may appear blank." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузите источники для начала. macOS может запросить доступ к записи экрана. Предпросмотр хранится в памяти; защищённое содержимое может быть пустым."
          }
        }
      }
    },
    "Load Sources…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
