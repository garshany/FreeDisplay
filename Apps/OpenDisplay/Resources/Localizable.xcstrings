    "×" : {},
    "“Native” is the sharpest: the picture is drawn 1:1, without scaling. A new mode has to be confirmed, or it reverts on its own." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чётче всего — «родное»: картинка рисуется 1:1, без масштабирования. Новый режим нужно подтвердить, иначе он вернётся сам."
          }
