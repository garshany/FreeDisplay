    "Power" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питание"
          }
        }
      }
    },
    "Power states" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режимы питания"
          }
        }
      }
    },
    "Preferences, display names, favourite resolutions, groups, app presets, protected layouts, shortcuts and scenes return to their defaults. A backup of the current settings is written first, and FreeDisplay then relaunches — like any quit, turning the displays it turned off back on." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки, названия экранов, избранные разрешения, группы, профили приложений, защищённые расположения, сочетания клавиш и сцены вернутся к значениям по умолчанию. Сначала будет создана резервная копия текущих настроек, затем FreeDisplay перезапустится и, как при любом завершении, снова включит выключенные им экраны."
          }
        }
      }
    },
    "Preferences, display names, favourite resolutions, groups, app presets, protected layouts, shortcuts, scenes, menu layout and luminance values return to their defaults. A backup of the current settings is written first, and FreeDisplay then relaunches — like any quit, turning the displays it turned off back on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки, имена дисплеев, избранные разрешения, группы, пресеты приложений, защищённые раскладки, сочетания клавиш, сцены, раскладка меню и значения яркости в нитах вернутся к значениям по умолчанию. Сначала записывается резервная копия текущих настроек, затем FreeDisplay перезапускается — как при любом выходе, снова включая отключённые им дисплеи."
          }
        }
      }
    },
    "Preferences, display names, favourite resolutions, groups, app presets, protected layouts, shortcuts, scenes, menu layout, luminance anchors, keyboard and audio bindings, idle-sleep requests and volume feedback preferences return to their defaults. A backup is written first, and FreeDisplay then relaunches — like any quit, turning the displays it turned off back on." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки, названия дисплеев, избранные разрешения, группы, профили приложений, защищённые расположения, сочетания клавиш, сцены, оформление меню, опорные значения яркости, привязки клавиатуры и звука, запросы запрета сна при простое и настройки индикации громкости вернутся к значениям по умолчанию. Сначала будет создана резервная копия, затем FreeDisplay перезапустится и, как при любом выходе, снова включит отключённые им дисплеи."
          }
        }
      }
    },
    "Preferred timing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочтительный тайминг"
