      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серийный номер (текст)"
          }
        }
      }
    },
    "Serial numbers, UUIDs, registry paths and the EDID bytes are hidden in this copy of the report." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
