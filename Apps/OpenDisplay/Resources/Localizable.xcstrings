            "value" : "Некоторые мониторы нельзя разбудить по DDC — тогда включите кнопкой."
          }
        }
      }
    },
    "Source" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник"
          }
        }
      }
    },
    "Source check failed; capture stopped: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка проверки источника; захват остановлен: %@"
          }
        }
      }
    },
    "Specify a single 3D LUT size from 2 to 64" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите один размер 3D LUT от 2 до 64"
          }
        }
      }
    },
    "Standby" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим ожидания"
          }
        }
      }
    },
    "Start Local Server" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить локальный сервер"
          }
        }
      }
    },
    "Start PIP" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить PIP"
          }
        }
      }
    },
    "Starting…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск…"
          }
        }
      }
    },
    "Starts OpenDisplay when you log in, so its display rules and brightness sync are there without you opening it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает OpenDisplay при входе в систему для применения правил мониторов и синхронизации яркости."
          }
        }
      }
    },
    "Stop" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановить"
          }
        }
      }
    },
    "Stopped" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановлен"
          }
        }
      }
    },
    "Style" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стиль"
          }
        }
      }
    },
    "Sunrise" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восход"
          }
        }
      }
    },
    "Sunrise / noon / sunset anchors need a location. Time anchors work without one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для восхода, полудня и заката нужно местоположение. Фиксированное время работает без него."
          }
        }
      }
    },
    "Sunset" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закат"
          }
        }
      }
    },
    "supported" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "поддерживается"
          }
        }
      }
    },
    "Switch a display preset when an app comes to the front" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Менять профиль монитора при переключении приложения"
          }
        }
      }
    },
    "Switches the monitor’s hardware colour preset to a warm one in the evening and back each morning. Follows Night Shift’s on/off state when it can be read; otherwise the schedule decides." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечером включает тёплый аппаратный цветовой режим, утром возвращает дневной. Следует состоянию Night Shift, если оно доступно, иначе использует расписание."
          }
        }
      }
    },
    "Sync" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация"
          }
        }
      }
    },
    "Synced with %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация с %@"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системный"
          }
        }
      }
    },
    "System Displays settings" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системные «Дисплеи»"
          }
        }
      }
    },
    "Takes effect after OpenDisplay relaunches." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применится после перезапуска OpenDisplay."
          }
        }
      }
    },
    "Television" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор"
          }
        }
      }
    },
    "Television display" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор"
          }
        }
      }
    },
    "That shortcut is already assigned." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сочетание клавиш уже назначено."
          }
        }
      }
    },
    "The auto-off timer elapsed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истёк таймер автоотключения."
          }
        }
      }
    },
    "The brightness keys control the chosen display, in hardware or software. The volume keys use DDC only when the sound plays through that monitor. Capturing the keys needs Accessibility permission; nothing is requested until you turn this on." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиши яркости управляют выбранным монитором через аппаратный или программный способ. Клавиши громкости используют DDC только если звук идёт через этот монитор. Для перехвата нужен доступ в разделе «Универсальный доступ»; разрешение запрашивается после включения."
          }
        }
      }
    },
    "The cause of the error is unknown." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Причина ошибки неизвестна."
          }
        }
      }
    },
    "The dimming method is shared by all displays. Temperature and dimming stay until you quit OpenDisplay." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Способ затемнения общий для всех экранов. Температура и затемнение действуют до выхода из OpenDisplay."
          }
        }
      }
    },
    "The display is no longer active. Refresh the display list." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран больше не активен. Обновите список экранов."
          }
        }
      }
    },
    "The display or the selected mode is unavailable." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран или выбранный режим недоступен."
          }
        }
      }
    },
    "The display was released, but macOS still reports it as connected. Use recovery if needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран освобождён, но macOS всё ещё считает его подключённым. При необходимости используйте восстановление."
          }
        }
      }
    },
    "The EDID extension count does not match the file size." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число расширений EDID не соответствует размеру файла."
          }
        }
      }
    },
    "The imported file isn’t matched to a display automatically. Check the manufacturer and product code before installing it by other means. OpenDisplay doesn’t install system configurations." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортированный файл не сопоставляется с дисплеем автоматически. Перед внешней установкой проверьте производителя и код модели. OpenDisplay не устанавливает системные конфигурации."
          }
        }
      }
    },
    "The last 30 minutes of display-related system log lines" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи системного журнала о мониторах за последние 30 минут"
          }
        }
      }
    },
    "The last active display can't be turned off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последний активный экран отключить нельзя"
          }
        }
      }
    },
    "The monitor didn't apply the change — its current picture mode may be blocking it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор не применил изменение — текущий режим изображения может блокировать его."
          }
        }
      }
    },
    "The monitor didn't respond over DDC. If control worked before, turn the monitor off and on with its power button and retry." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор не ответил по DDC. Если управление раньше работало, выключите и включите монитор его кнопкой питания и повторите опрос."
          }
        }
      }
    },
    "the monitor ignored the value" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "монитор не применил значение"
          }
        }
      }
    },
    "The monitor ignored this change. Its picture mode may lock this setting." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор не применил изменение. Текущий режим изображения может блокировать эту настройку."
          }
        }
      }
    },
    "The monitor kept the “%@” mode." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор оставил режим «%@»."
          }
        }
      }
    },
    "The monitor restores its factory settings — brightness, contrast, colour mode, and anything else it resets. OpenDisplay also clears its software dimming and colour temperature for this display." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает заводские настройки монитора: яркость, контрастность, цветовой режим и остальные параметры, которые сбрасывает сам монитор. OpenDisplay также снимает программное затемнение и цветовую температуру."
          }
        }
      }
    },
    "The monitor stayed on %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор сохранил режим «%@»."
          }
        }
      }
    },
    "The monitor will restore its factory brightness, contrast, color mode, and everything else." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монитор вернёт заводские яркость, контраст, цветовой режим и остальное."
          }
        }
      }
    },
    "The monitor’s real backlight follows the built-in display over DDC. Moving a slider teaches it your preferred offset and pauses it for a minute. With the lid closed it follows the schedule instead. Brightness changed with the monitor’s own buttons isn’t tracked. Displays in a group are driven by their group." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизирует аппаратную яркость внешнего монитора со встроенным по DDC. Ручное изменение задаёт смещение и приостанавливает синхронизацию на минуту. При закрытой крышке используется расписание. Изменения кнопками монитора не отслеживаются. Мониторами в группе управляет группа."
          }
        }
      }
    },
    "The refresh rate must be between 24 and 120 Hz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота обновления должна быть от 24 до 120 Гц."
          }
        }
      }
    },
    "The source disappeared. Load sources again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник исчез. Загрузите источники снова."
          }
        }
      }
    },
    "The source disappeared; capture stopped." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник исчез; захват остановлен."
          }
        }
      }
    },
    "The update feed offers OpenDisplay %@, which is older than the %@ you are running. Nothing was installed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник обновлений предлагает OpenDisplay %@ — эта версия старше установленной %@. Ничего не установлено."
          }
        }
      }
    },
    "These switch the boost off to save battery. When power returns, the last option can put your previous brightness back, unless you’ve changed it yourself since. The timer doesn’t give back time already spent." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти условия отключают усиление для экономии аккумулятора. После восстановления питания можно вернуть прежний уровень, если вы не меняли его вручную. Таймер не сбрасывает уже потраченное время."
          }
        }
      }
    },
    "This build is updated from source: pull the project’s changes, build the app, and replace the installed copy. Automatic release downloads aren’t available here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка обновляется из исходников: загрузите изменения проекта, соберите приложение и замените установленную версию. Автоматическая загрузка выпусков здесь недоступна."
          }
        }
      }
    },
    "This display set" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот набор мониторов"
          }
        }
      }
    },
    "This display’s own brightness offset when the group moves together" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индивидуальная поправка яркости при общей регулировке группы"
          }
        }
      }
    },
    "This exact mode is no longer available. A different framebuffer or refresh rate is never substituted automatically." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот точный режим больше недоступен. Другой буфер или частота автоматически не подставляются."
          }
        }
      }
    },
    "This macOS version doesn’t support the required API." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия macOS не поддерживает необходимый API."
          }
        }
      }
    },
    "This macOS version lacks the required virtual screen API." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой версии macOS отсутствует необходимый API виртуальных экранов."
          }
        }
      }
    },
    "Time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время"
          }
        }
      }
    },
    "Toggles" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключатели"
          }
        }
      }
    },
    "Too many samples" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много образцов"
          }
        }
