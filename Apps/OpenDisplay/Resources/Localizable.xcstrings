    },
    "evening warmth active" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "вечерний тёплый режим включён"
          }
        }
      }
    },
    "Event notices" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления о событиях"
          }
        }
      }
    },
    "Every connected display is in a named group" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все подключённые экраны входят в именованные группы"
          }
        }
      }
    },
    "Every detail FreeDisplay can read, to copy or save" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сведения, которые может прочитать FreeDisplay, — для копирования или сохранения"
          }
        }
      }
    },
    "Every display FreeDisplay has a record of, including ones that aren’t connected now. A record holds the display’s name in FreeDisplay, favourite modes, menu settings, group memberships and protected layouts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все экраны, о которых у FreeDisplay есть запись, включая неподключённые сейчас. В записи хранятся название экрана в FreeDisplay, избранные режимы, настройки меню, участие в группах и защищённые расположения."
          }
        }
      }
    },
    "Every display moves by the same amount, keeping existing differences until one reaches its limit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый экран меняется на ту же величину, сохраняя существующую разницу, пока один из них не упрётся в предел."
          }
        }
      }
    },
    "Every display takes the leading display’s brightness percentage." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый экран получает тот же процент яркости, что и ведущий."
          }
        }
      }
    },
    "Every saved identifier and relationship" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сохранённые идентификаторы и связи"
          }
        }
      }
    },
    "Everything here only reads. Nothing writes to the display, installs a configuration or changes a mode." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь всё только читается. Ничего не записывается в дисплей, не устанавливаются конфигурации и не меняется режим."
          }
        }
      }
    },
    "Executable must be an absolute literal path" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исполняемый файл должен быть задан буквальным абсолютным путём"
          }
        }
      }
    },
    "expanded" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "развёрнуто"
          }
        }
      }
    },
    "Expected a named parameter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидается именованный параметр."
