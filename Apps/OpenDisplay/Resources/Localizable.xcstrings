    },
    "Modes macOS already offers are chosen in the regular resolution list. Custom physical modes need external setup with administrator rights. Only the sizes and the restore steps are exported here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступные режимы macOS выбираются в обычном списке разрешений. Пользовательские физические режимы требуют внешней настройки с правами администратора. Здесь экспортируются только размеры и порядок восстановления."
          }
        }
      }
    },
    "Modes shown: %lld. Modes macOS lists for this display: %lld." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
