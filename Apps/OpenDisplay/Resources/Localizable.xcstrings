    "Nothing to reconnect" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключать нечего"
          }
        }
      }
    },
    "Nothing was changed. Your update settings stay as they are." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменено. Настройки обновления сохранены."
          }
        }
      }
    },
    "Nothing was changed: FreeDisplay still has “%@” switched off. Reconnect it first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменено: «%@» всё ещё выключен FreeDisplay. Сначала подключите его."
          }
        }
      }
    },
    "Nothing was changed: “%@” is no longer remembered." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменено: «%@» больше не числится в записях."
          }
        }
      }
    },
    "Nothing was changed: “%@” was connected or disconnected meanwhile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не изменено: «%@» за это время подключили или отключили."
          }
        }
      }
    },
    "Nothing was sent: FreeDisplay has no usable DDC connection to this monitor." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не отправлено: у FreeDisplay нет рабочего DDC-подключения к этому монитору."
          }
        }
      }
    },
    "Nothing was transferred. The preview or identity changed; close this sheet and review a new preview." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не перенесено. Данные предпросмотра или идентификации изменились; закройте окно и откройте новый предпросмотр."
          }
        }
      }
    },
    "Nothing you have set up would have acted on its own." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего из того, что вы настроили, не сработало бы само."
          }
        }
      }
    },
    "Notices about displays connecting or disconnecting, the built-in turning off automatically, protection results and failures. Confirmation prompts and the on-screen display are separate and work whatever is chosen here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления о подключении и отключении экранов, автоматическом выключении встроенного экрана, результатах защиты и сбоях. Запросы подтверждения и экранный индикатор работают отдельно — независимо от выбранного здесь."
          }
        }
      }
    },
    "Notification Center" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Центр уведомлений"
          }
        }
      }
    },
    "Notification name must be a literal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя уведомления должно быть буквальным"
          }
        }
      }
    },
    "Notifications are off for FreeDisplay in System Settings, so notices won’t appear. Everything else works as usual." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для FreeDisplay выключены в Системных настройках, поэтому они не появятся. Всё остальное работает как обычно."
          }
        }
      }
    },
    "Now running on battery power." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac перешёл на питание от аккумулятора."
          }
        }
      }
    },
    "Nowhere" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нигде"
          }
        }
      }
