    },
    "Protected layout" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищённое расположение"
          }
        }
      }
    },
    "Protected layout is on for these displays. A move made here isn’t saved into it: the next time the arrangement changes, the protected layout is put back. Update the protected layout to keep the new one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этих экранов включено защищённое расположение. Перемещение здесь в него не сохраняется: при следующем изменении расположения будет восстановлено защищённое. Обновите защищённое расположение, чтобы сохранить новое."
          }
        }
      }
    },
    "Protected layouts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищённые расположения"
          }
        }
      }
    },
