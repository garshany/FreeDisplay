    "provider health" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "состояние провайдера"
          }
        }
      }
    },
    "Providers" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдеры"
          }
        }
      }
    },
    "public APIs only" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "только публичные API"
          }
        }
      }
    },
    "Publishes each brightness and volume change FreeDisplay makes — including slider, HTTP, command-line and Shortcuts brightness changes — over the dev.opendisplay.osd distributed notification, whether or not FreeDisplay shows its own HUD. Off by default." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаёт каждое изменение яркости и громкости, сделанное FreeDisplay, — включая изменения яркости ползунком, по HTTP, из командной строки и из «Быстрых команд» — через распределённое уведомление dev.opendisplay.osd, независимо от того, показывает ли FreeDisplay свой индикатор. По умолчанию выключено."
          }
        }
      }
    },
    "Publishes each brightness, volume, mute and input change FreeDisplay makes — including slider, display-group, HTTP, command-line and Shortcuts changes — over the dev.opendisplay.osd distributed notification, whether or not FreeDisplay shows its own HUD. Off by default." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет каждое изменение яркости, громкости, состояния звука и входа, выполненное FreeDisplay, через распределённое уведомление dev.opendisplay.osd. Включает изменения ползунком, группой дисплеев, HTTP, командной строкой и Командами независимо от собственной индикации FreeDisplay. По умолчанию выключено."
          }
        }
      }
    },
