    "With HDR content, colour-table contrast can clip highlights or look different." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С HDR-содержимым контрастность через таблицу цветов может обрезать светлые участки или выглядеть иначе."
          }
        }
      }
    },
    "With no display chosen, it sets the built-in display." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если дисплей не выбран, изменяет встроенный дисплей."
          }
        }
      }
    },
    "Without a physical size no pixel density can be calculated." : {
