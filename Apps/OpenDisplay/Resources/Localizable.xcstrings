    },
    "Keep the new main display?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить новый основной экран?"
          }
        }
      }
    },
    "Keep the new mode?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить новый режим?"
          }
        }
      }
    },
    "Keep these display settings?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранить эти настройки монитора?"
          }
        }
      }
    },
    "Keeping displays awake with an external screen" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предотвращение сна дисплеев при подключённом внешнем экране"
          }
        }
      }
    },
    "Keeping the displays awake while it is connected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрет сна дисплеев, пока этот дисплей подключён"
          }
        }
      }
    },
    "Keeping the displays you turned off switched off" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторное выключение экранов, которые вы выключили"
          }
        }
      }
    },
    "Keeps" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется"
          }
        }
      }
    },
    "Keeps a verified mode immediately. Leave off to keep the keep-or-revert window." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу сохраняет проверенный режим. Оставьте выключенным, чтобы сохранить окно подтверждения или отмены."
          }
        }
      }
    },
    "Keeps the screens from going to sleep while at least one external display is connected. Released automatically when the last external display is disconnected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не даёт экранам уходить в сон, пока подключён хотя бы один внешний монитор. Блокировка автоматически снимается после отключения последнего внешнего монитора."
          }
        }
      }
    },
    "Kept outside the standard profile folders, for example inside an app. Counts as a custom profile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится вне стандартных папок профилей, например внутри программы. Считается пользовательским профилем."
          }
        }
      }
    },
    "kept until at least %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "хранится как минимум до %@"
          }
        }
      }
    },
    "kept while this record is protected from automatic forgetting" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "хранится, пока запись защищена от автоматического удаления"
          }
        }
      }
    },
