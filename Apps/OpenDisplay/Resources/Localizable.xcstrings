        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять отключение"
          }
        }
      }
    },
    "Keep displays awake while an external is connected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не усыплять мониторы, пока подключён внешний"
          }
        }
      }
    },
    "Keep displays awake while connected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давать дисплеям засыпать при подключении"
          }
        }
      }
    },
    "Keep displays awake while external connected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не гасить экраны при подключённом мониторе"
          }
        }
      }
    },
    "Keep displays awake while this display is connected" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давать дисплеям засыпать, пока этот дисплей подключён"
          }
        }
      }
    },
    "Keep the new arrangement?" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить новое расположение?"
          }
        }
