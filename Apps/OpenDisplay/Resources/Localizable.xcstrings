            "value" : "Проектор"
          }
        }
      }
    },
    "Protect Current Layout" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитить текущее расположение"
          }
        }
      }
    },
    "Protected layout" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищённое расположение"
          }
        }
      }
    },
    "Protected layout is on for these displays. A move made here isn’t saved into it: the next time the arrangement changes, the protected layout is put back. Update the protected layout to keep the new one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этих экранов включено защищённое расположение. Перемещение здесь в него не сохраняется: при следующем изменении расположения будет восстановлено защищённое. Обновите защищённое расположение, чтобы сохранить новое."
          }
        }
      }
    },
    "Protected layouts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищённые расположения"
          }
        }
      }
    },
    "Protected layouts are not transferred; layouts referencing a forgotten source are removed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищённые раскладки не переносятся; при удалении источника связанные раскладки удаляются"
          }
        }
      }
    },
    "Protected · displays: %lld · saved %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищено · мониторов: %lld · сохранено %@"
          }
        }
