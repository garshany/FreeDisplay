        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной дисплей"
          }
        }
      }
    },
    "Main display (menu bar and Dock)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основной экран (строка меню и Dock)"
