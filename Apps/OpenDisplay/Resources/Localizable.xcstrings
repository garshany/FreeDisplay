    "Process actions use an absolute executable and a JSON argument array. Metadata stays in individual arguments; no inline shell code. HTTP/URL placeholders are percent encoded. Notification names are literal." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для запуска процесса задаются абсолютный путь и массив аргументов JSON. Метаданные передаются отдельными аргументами; встроенный код оболочки не используется. Подстановки в HTTP/URL кодируются для URL. Имена уведомлений используются буквально."
          }
        }
      }
    },
    "Process exited unsuccessfully; inspect its exit code and output" : {
      "extractionState" : "manual",
      "localizations" : {
