    },
    "Make ${display} the main display" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделать ${display} основным дисплеем"
          }
        }
      }
    },
    "Make the Next Display Main" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделать основным следующий дисплей"
          }
        }
      }
    },
    "Makes a connected display the main display, the one with the menu bar. The displays keep their arrangement. Returns the main display macOS reports afterwards." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает подключённый дисплей основным — тем, на котором строка меню. Расположение дисплеев сохраняется. Возвращает основной дисплей, о котором после этого сообщает macOS."
          }
        }
      }
    },
    "Manage App Settings" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление настройками приложения"
          }
        }
      }
    },
    "Manage display" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управление экраном"
          }
        }
      }
    },
    "Manage…" : {
      "localizations" : {
        "ru" : {
