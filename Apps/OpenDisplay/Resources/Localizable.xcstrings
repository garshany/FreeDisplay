    "'%@' would mutate app-owned state without an IPC adapter. Quit FreeDisplay or use a typed command (opendisplay commands)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» изменит состояние, принадлежащее приложению, в обход IPC-адаптера. Закройте FreeDisplay или используйте типизированную команду (opendisplay commands)."
          }
        }
      }
    },
