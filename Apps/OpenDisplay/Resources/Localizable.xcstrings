    "Set Display Mode" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установить режим дисплея"
          }
        }
      }
    },
    "Set Display Mode offers Without confirmation, off by default. Turn it on explicitly to keep the applied mode immediately." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В действии «Задать режим дисплея» есть параметр «Без подтверждения», по умолчанию выключенный. Явно включите его, чтобы сразу сохранить применённый режим."
          }
        }
      }
    },
    "Set Main Display" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбрать основной дисплей"
          }
        }
      }
    },
    "Set the brightness of ${display} to ${percent} %" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установить яркость ${display}: ${percent} %"
          }
        }
      }
    },
    "Sets a display's brightness to an absolute level and reports the level read back." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает абсолютную яркость дисплея и сообщает считанное после изменения значение."
          }
        }
      }
    },
    "Sets a display’s brightness in percent (0–100) and reports the level the display confirms afterwards. With no display chosen, it sets the built-in display." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает яркость дисплея в процентах (0–100) и сообщает уровень, который дисплей подтвердил. Если дисплей не выбран, меняется яркость встроенного дисплея."
          }
        }
      }
    },
    "Sets external-display brightness at times you choose — fixed clock times or sunrise, solar noon, and sunset with an offset — gliding between points. Changes are silent (no HUD). This schedule takes priority over Adaptive brightness sync." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет яркость внешних мониторов в заданное время или относительно восхода, полудня и заката, со смещением и плавными переходами. Индикатор не показывается. Это расписание имеет приоритет над адаптивной синхронизацией."
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки"
          }
        }
      }
    },
