    "Decoded EDID" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифрованный EDID"
          }
        }
      }
    },
    "Decoded values are what the bytes state. They don’t prove the display or macOS supports them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифрованные значения — это то, что записано в байтах. Они не доказывают, что дисплей или macOS это поддерживают."
          }
        }
      }
    },
    "Decoded values are what the EDID states — advertised capability and receiver maxima, not measured values or the current link." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифрованные значения — это то, что заявлено в EDID: объявленные возможности и максимумы приёмника, а не измеренные значения и не текущее соединение."
          }
        }
      }
    },
