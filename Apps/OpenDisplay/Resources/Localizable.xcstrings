            "value" : "Открыть папку"
          }
        }
      }
    },
    "Open FreeDisplay Settings" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки FreeDisplay"
          }
        }
      }
    },
    "Open in ColorSync Utility" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть в ColorSync-утилите"
          }
        }
      }
    },
    "Open Keyboard Shortcuts…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть сочетания клавиш…"
          }
        }
      }
    },
    "Open Login Items Settings…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть настройки объектов входа…"
          }
        }
      }
    },
    "Open Menu Panel" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
