    "Follow changes made outside OpenDisplay" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывать изменения, сделанные вне OpenDisplay"
          }
        }
      }
    },
    "Follow the sun’s position" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывать положение солнца"
          }
        }
      }
    },
    "following built-in" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "синхронизация со встроенным экраном"
          }
        }
      }
    },
    "following built-in (%+d%%)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "следует за встроенным (%+d%%)"
          }
