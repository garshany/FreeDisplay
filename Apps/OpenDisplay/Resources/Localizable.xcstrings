    "full" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "полная"
          }
        }
      }
    },
    "Full mode: logical size, framebuffer, refresh rate and HiDPI, then the markers macOS reports for it" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный режим: логический размер, буфер изображения, частота и HiDPI, затем отметки, которые macOS сообщает для него"
          }
        }
      }
    },
    "Full report" : {
