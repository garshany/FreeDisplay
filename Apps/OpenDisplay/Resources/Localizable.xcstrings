        }
      }
    },
    "%@ is now the main display. Keep the arrangement in FreeDisplay within %lld seconds, or it reverts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ теперь является основным дисплеем. Сохраните расположение в FreeDisplay в течение %lld секунд, иначе оно будет восстановлено."
          }
        }
      }
    },
    "%@ is now the main display. Keep the change in FreeDisplay within %lld seconds, or it reverts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ теперь основной экран. Подтвердите изменение в FreeDisplay в течение %lld с, иначе оно будет отменено."
          }
        }
      }
    },
    "%@ is offline." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отключён."
          }
        }
      }
    },
    "%@ is reserved for Reconnect All Displays, the recovery shortcut that works when the screens can’t be used. To use these keys for something else, remove the Reconnect All Displays shortcut first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ зарезервировано для подключения всех дисплеев — восстановления, доступного, когда экранами нельзя пользоваться. Чтобы назначить эти клавиши другому действию, сначала удалите сочетание подключения всех дисплеев."
          }
        }
      }
    },
    "%@ is still mirrored" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %@ не снят повтор"
          }
        }
      }
    },
    "%@ moved to %@ to keep the pair in order." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: значение изменено на %@, чтобы пара осталась упорядоченной."
          }
        }
      }
    },
    "%@ rejected the input switch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
