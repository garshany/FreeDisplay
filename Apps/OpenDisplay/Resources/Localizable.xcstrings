    "horizontal: front porch %1, sync %2, blanking %3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "по горизонтали: передний порог %1, синхроимпульс %2, гашение %3"
          }
        }
      }
    },
    "How far one press of a brightness or volume key, or a level shortcut, moves the level. Leave a field empty for its default." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Величина изменения за одно нажатие клавиши яркости или громкости либо сочетания изменения уровня. Пустое поле означает значение по умолчанию."
          }
        }
      }
    },
    "How far one press of a brightness or volume key, or of a brightness shortcut, moves the level. Leave a field empty for its default." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько меняется уровень за одно нажатие клавиши яркости или громкости либо сочетания для яркости. Оставьте поле пустым, чтобы использовать значение по умолчанию."
          }
        }
      }
    },
    "How the keyboard’s brightness and volume keys treat this display. Sliders, shortcuts and automation aren’t affected, and hiding the display from the menu doesn’t change this." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как клавиши яркости и громкости управляют этим дисплеем. Эти настройки не влияют на ползунки, сочетания клавиш и автоматизацию и не зависят от скрытия дисплея в меню."
          }
        }
      }
    },
