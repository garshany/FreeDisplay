<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- English is the source language; Russian ships from Localizable/InfoPlist.xcstrings. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleName</key>
	<string>FreeDisplay</string>
	<key>CFBundleDisplayName</key>
	<string>FreeDisplay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Menu-bar agent: no Dock icon (PRD UX-001). -->
	<key>LSUIElement</key>
	<true/>
	<!-- Clock Mode (Issue 30): optional one-shot location lookup to auto-fill the sunrise/sunset
	     latitude & longitude. Only requested when the user taps "Use current location"; a manual
	     entry is always available instead. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FreeDisplay uses your location once to calculate local sunrise, noon, and sunset times for Clock Mode brightness schedules. You can also enter your coordinates manually.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FreeDisplay discovers TVs, connects to the TV you explicitly pair, and sends wake requests only when you ask.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Device-local ws endpoints are an explicit controller choice. This does not disable TLS
		     validation for wss or allow arbitrary remote insecure loads. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- FreeDisplay-owned configuration; an empty key keeps Sparkle off. The local-build guard
	     remains true until the owner validates signed fork releases end to end. See scripts/sparkle-setup.md. -->
	<key>SUFeedURL</key>
	<string>$(FREEDISPLAY_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(FREEDISPLAY_UPDATE_PUBLIC_ED_KEY)</string>
	<key>OpenDisplayLocalBuild</key>
	<true/>
	<!-- opendisplay:// URL-scheme automation (Issue 4). Routes onto the same safety-checked,
	     audited CommandGateway as the CLI and App Intents; only non-destructive recovery
	     commands auto-run, arrangement-altering ones require in-app confirmation. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>opendisplay</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
