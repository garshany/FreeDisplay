{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FreeDisplay discovers TVs, connects to the TV you explicitly pair, and sends wake requests only when you ask."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FreeDisplay ищет телевизоры, подключается к телевизору, с которым вы явно выполнили сопряжение, и отправляет запросы пробуждения только по вашей команде."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FreeDisplay uses your location once to calculate local sunrise, noon, and sunset times for Clock Mode brightness schedules. You can also enter your coordinates manually."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FreeDisplay один раз использует ваше местоположение, чтобы рассчитать местное время восхода, полудня и заката для расписания яркости. Координаты можно ввести и вручную."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
